# ==============================================================================
# Block Explorer - Environment Variables Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to create your local environment file:
#    cp .env.example .env
# 2. Replace the placeholder values with your actual API keys.
# 3. Never commit your real `.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Maps Platform API Key (Client-side)
# ------------------------------------------------------------------------------
# Required for interactive map rendering, satellite imagery, and Geocoding V4 REST requests.
# Enable the following APIs in Google Cloud Console (https://console.cloud.google.com/):
#   - Maps JavaScript API
#   - Geocoding API
VITE_GOOGLE_MAPS_API_KEY="AIzaSyYourGoogleMapsApiKeyHere"

# ------------------------------------------------------------------------------
# Google Gemini AI API Key (Server-side)
# ------------------------------------------------------------------------------
# Required for dynamic local insights generation and AI trivia quiz questions.
# Get a free API key at Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="YourGeminiApiKeyHere"

# ------------------------------------------------------------------------------
# Application URL (Optional / Production)
# ------------------------------------------------------------------------------
# The base URL where the application is deployed or hosted.
APP_URL="http://localhost:3000"
